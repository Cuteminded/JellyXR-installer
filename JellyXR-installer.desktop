[Desktop Entry]
Type=Application
Name=Install JellyXR
Comment=Install, update, or uninstall JellyXR
Exec=sh -c 'rm -f /tmp/jellyxr_install_script.sh; if curl -S -s -L -O --output-dir /tmp/ --connect-timeout 60 https://github.com/Cuteminded/JellyXR-installer/releases/latest/download/jellyxr_install_script.sh; then bash /tmp/jellyxr_install_script.sh; else echo "Something went wrong, please report this if it is a bug"; read; fi'
Icon=system-software-install
Terminal=true
Categories=Utility;
StartupNotify=false
